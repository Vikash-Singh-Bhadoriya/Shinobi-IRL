# Shinobi-IRL — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ---------------------------------------------------------------------------
# PostHog Analytics (optional)
# ---------------------------------------------------------------------------
# Get your project API key from: https://posthog.com → Project Settings → API Keys
# If VITE_POSTHOG_KEY is missing or empty, analytics is silently disabled.
# The app works normally with no key set.
#
VITE_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_PROJECT_API_KEY

# PostHog ingestion host (optional — defaults to US cloud if not set)
# Use https://eu.i.posthog.com for EU data residency.
VITE_POSTHOG_HOST=https://us.i.posthog.com
